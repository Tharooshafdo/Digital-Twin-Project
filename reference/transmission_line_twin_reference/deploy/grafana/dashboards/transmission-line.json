{
  "uid": "transmission-twin-v2",
  "title": "Transmission line twin v2",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Measured and predicted receiving voltage",
      "datasource": {
        "type": "postgres",
        "uid": "twin-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kvolt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_time::timestamptz AS time, vr_measured_kv AS measured, vr_predicted_kv AS predicted FROM twin_states WHERE run_id=${run:sqlstring} AND asset_id=${asset:sqlstring} AND $__timeFilter(event_time::timestamptz) ORDER BY event_time::timestamptz"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Raw physics voltage residual",
      "datasource": {
        "type": "postgres",
        "uid": "twin-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kvolt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_time::timestamptz AS time, vr_residual_kv AS residual FROM twin_states WHERE run_id=${run:sqlstring} AND asset_id=${asset:sqlstring} AND $__timeFilter(event_time::timestamptz) ORDER BY event_time::timestamptz"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active loss",
      "datasource": {
        "type": "postgres",
        "uid": "twin-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mwatt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_time::timestamptz AS time, loss_predicted_mw AS loss FROM twin_states WHERE run_id=${run:sqlstring} AND asset_id=${asset:sqlstring} AND $__timeFilter(event_time::timestamptz) ORDER BY event_time::timestamptz"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Line loading",
      "datasource": {
        "type": "postgres",
        "uid": "twin-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_time::timestamptz AS time, loading_percent AS loading FROM twin_states WHERE run_id=${run:sqlstring} AND asset_id=${asset:sqlstring} AND $__timeFilter(event_time::timestamptz) ORDER BY event_time::timestamptz"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Latest status and origin",
      "datasource": {
        "type": "postgres",
        "uid": "twin-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_time, data_origin, model_status, assessment, parameter_version, topology_version FROM twin_states WHERE run_id=${run:sqlstring} AND asset_id=${asset:sqlstring} ORDER BY event_time DESC LIMIT 1"
        }
      ]
    }
  ],
  "time": {
    "from": "2026-01-01T00:00:00Z",
    "to": "2026-01-02T00:00:00Z"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "type": "query",
        "query": "SELECT DISTINCT run_id FROM twin_states ORDER BY run_id",
        "datasource": {
          "type": "postgres",
          "uid": "twin-postgres"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "asset",
        "type": "query",
        "query": "SELECT DISTINCT asset_id FROM twin_states ORDER BY asset_id",
        "datasource": {
          "type": "postgres",
          "uid": "twin-postgres"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  }
}